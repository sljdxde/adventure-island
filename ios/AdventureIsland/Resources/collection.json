      "lockedLabel": "？？？",
      "items": [
        {
          "id": "sci-apple",
          "name": "苹果",
          "icon": "apple",
          "fact": "苹果能浮起来，是因为果肉里藏着小气孔，像穿了救生衣！",
          "tag": "浮",
          "tagColor": "blue"
        },
        {
          "id": "sci-rock",
          "name": "石头",
          "icon": "rock",
          "fact": "石头比同体积的水重很多，所以一放就沉底啦。",
          "tag": "沉",
          "tagColor": "coral"
        },
        {
          "id": "sci-wood",
          "name": "木头",
          "icon": "wood",
          "fact": "木头里有很多小空隙，轻轻的，所以能浮在水面上。",
          "tag": "浮",
          "tagColor": "blue"
        },
        {
          "id": "sci-key",
          "name": "钥匙",
          "icon": "key",
          "fact": "金属钥匙个头小却很重，扑通一下就沉下去了。",
          "tag": "沉",
          "tagColor": "coral"
        },
        {
          "id": "sci-sponge",
          "name": "海绵",
          "icon": "sponge",
          "fact": "干海绵会浮，吸满水之后会慢慢往下沉，试试看！",
          "tag": "浮",
          "tagColor": "blue"
        },
        {
          "id": "sci-balloon",
          "name": "气球",
          "icon": "balloon",
          "fact": "气球里装的是空气，最轻最轻，漂在最上面。",
          "tag": "浮",
          "tagColor": "blue"
        },
        {
          "id": "sci-ice",
          "name": "冰块",
          "icon": "ice",
          "fact": "冰比水轻一点点，所以冰块会浮在饮料上。",
          "tag": "浮",
          "tagColor": "blue"
        },
        {
          "id": "sci-magnet",
          "name": "磁铁",
          "icon": "magnet",
          "fact": "磁铁能吸住铁做的东西，比如回形针和钥匙。"
        },
        {
          "id": "sci-rainbow",
          "name": "彩虹",
          "icon": "rainbow",
          "fact": "阳光穿过小水滴，会折出七种颜色。"
        },
        {
          "id": "sci-volcano",
          "name": "火山",
          "icon": "volcano",
          "fact": "岩浆压力太大时，就会从火山口喷出来。"
        },
        {
          "id": "sci-sprout",
          "name": "种子",
          "icon": "sprout",
          "fact": "种子喝饱水、晒到太阳，就会发芽长大。"
        },
        {
          "id": "sci-heart",
          "name": "心跳",
          "icon": "heart",
          "fact": "你的心脏一直在跳，跑完步会跳得更快哦。"
        }
